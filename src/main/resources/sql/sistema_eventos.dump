--
-- Name: palestrante; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.palestrante (
    id integer NOT NULL,
    nome character varying(200),
    biografia text,
    cpf character(11) NOT NULL
);


ALTER TABLE public.palestrante OWNER TO postgres;

--
-- Name: dashboard_palestrantes; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.dashboard_palestrantes AS
 SELECT p.id,
    p.nome,
    p.biografia,
    p.cpf,
    COALESCE(i.qtd_palestras, (0)::bigint) AS nro_palestras
   FROM (public.palestrante p
     LEFT JOIN ( SELECT pp.palestrante_id,
            count(pp.palestra_id) AS qtd_palestras
           FROM public.palestra_palestrante pp
          GROUP BY pp.palestrante_id) i ON ((i.palestrante_id = p.id)))
  ORDER BY COALESCE(i.qtd_palestras, (0)::bigint) DESC NULLS LAST;


ALTER VIEW public.dashboard_palestrantes OWNER TO postgres;


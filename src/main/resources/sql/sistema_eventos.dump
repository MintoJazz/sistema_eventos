--
-- Name: evento; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.evento (
    id integer NOT NULL,
    nome character varying(200),
    data_inicio date DEFAULT CURRENT_DATE,
    data_fim date DEFAULT CURRENT_DATE,
    localidade text
);


ALTER TABLE public.evento OWNER TO postgres;

--
-- Name: dashboard_eventos; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.dashboard_eventos AS
 SELECT id,
    nome,
    data_inicio,
    data_fim,
    localidade,
        CASE
            WHEN (data_inicio > CURRENT_DATE) THEN 'Futuro'::text
            WHEN (data_fim >= CURRENT_DATE) THEN 'Em Andamento'::text
            ELSE 'Encerrado'::text
        END AS status_evento
   FROM public.evento;


ALTER VIEW public.dashboard_eventos OWNER TO postgres;

--
-- Name: inscricao; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.inscricao (
    id integer NOT NULL,
    evento_id integer,
    participante_id integer,
    data_hora timestamp without time zone DEFAULT CURRENT_TIMESTAMP,
    valor numeric DEFAULT 0,
    pago boolean DEFAULT false,
    CONSTRAINT inscricao_valor_check CHECK (((valor)::numeric(8,2) >= (0)::numeric))
);


ALTER TABLE public.inscricao OWNER TO postgres;

--
-- Name: participante; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.participante (
    id integer NOT NULL,
    nome character varying(200),
    data_nascimento date,
    cpf character varying(11) NOT NULL,
    email text
);


ALTER TABLE public.participante OWNER TO postgres;

--
-- Name: dashboard_inscricoes; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.dashboard_inscricoes AS
 SELECT i.id AS inscricao_id,
    i.valor,
    i.data_hora,
    i.pago,
    e.id AS evento_id,
    e.nome AS evento_nome,
    e.data_inicio,
    e.data_fim,
    e.localidade,
    e.status_evento,
    p.id AS participante_id,
    p.nome AS participante_nome,
    p.cpf,
    p.email,
    p.data_nascimento
   FROM ((public.inscricao i
     JOIN public.dashboard_eventos e ON ((i.evento_id = e.id)))
     JOIN public.participante p ON ((i.participante_id = p.id)))
  ORDER BY i.data_hora DESC;


ALTER VIEW public.dashboard_inscricoes OWNER TO postgres;

